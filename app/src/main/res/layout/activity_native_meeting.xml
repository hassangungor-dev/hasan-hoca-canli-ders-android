<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meetingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Hasan Hoca Canlı Ders"
                android:textColor="#1F2328"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meetingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ders bağlantısı hazırlanıyor…"
                android:textColor="#667085"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/input_background"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="🔒 Güvenli ders"
            android:textColor="#344054"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#17191C">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Hasan Hoca\nCanlı Ders"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/micButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:minWidth="88dp"
                android:text="🎙\nSessiz"
                android:textAllCaps="false"
                android:textColor="#1F2328"
                android:textSize="12sp" />

            <Button
                android:id="@+id/shareScreenButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:minWidth="105dp"
                android:text="▣\nEkranı paylaş"
                android:textAllCaps="false"
                android:textColor="#16883E"
                android:textSize="12sp" />

            <Button
                android:id="@+id/participantsButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:minWidth="100dp"
                android:text="♟\nKatılımcılar"
                android:textAllCaps="false"
                android:textColor="#1F2328"
                android:textSize="12sp" />

            <Button
                android:id="@+id/recordButton"
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"
                android:enabled="false"
                android:minWidth="92dp"
                android:text="●\nKayıt"
                android:textAllCaps="false"
                android:textColor="#D92D20"
                android:textSize="12sp" />

            <Button
                android:id="@+id/endLessonButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:backgroundTint="#E5484D"
                android:minWidth="92dp"
                android:text="Dersi bitir"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
